{
  "name": "BossAutomateRobot",
  "description": "Boss自动化机器人",
  "version": "1.0.13",
  "main": "index.js",
  "type": "module",
  "repository": "https://github.com/snaketzy/electron-demo3.git",
  "author": "Jerry Tang <snaketzy@gmail.com>",
  "license": "MIT",
  "scripts": {
    "start": "chcp 65001 && electron . ",
    "automate": "node ./Automate.js",
    "patchupdate": "npm version patch --no-git-tag-version",
    "pacakge": "electron-builder --dir",
    "portable": "node -e \"console.log('当前时间是：' + new Date().toLocaleString())\" && npm run patchupdate && electron-builder --dir --win portable",
    "msi": "electron-builder --win"
  },
  "dependencies": {
    "dayjs": "^1.11.18",
    "express": "^5.1.0",
    "ghost-cursor": "^1.4.1",
    "node-fetch": "2",
    "puppeteer-core": "^24.17.0",
    "puppeteer-in-electron": "^3.0.5"
  },
  "devDependencies": {
    "asarmor": "^2.0.0",
    "electron": "^37.3.1",
    "electron-builder": "^26.0.12"
  },
  "resolutions": {
    "minimatch": "9.0.5"
  },
  "build": {
    "appId": "com.example.bossautomaterobot",
    "productName": "Boss自动化机器人",
    "portable": {
      "artifactName": "${productName}-${version}-portable.${ext}"
    },
    "win": {
      "target": "portable",
      "icon": "icons/icon.ico"
    },
    "afterPack": "./myAfterPackHook.cjs"
  }
}
